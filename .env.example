# Copy to .env.local for local development. Never commit real secrets (ADR-0007).
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Perfume Store"
# Public base URL of product media (object storage / CDN); empty = use media.url as stored
NEXT_PUBLIC_MEDIA_BASE_URL=
# PostgreSQL 17 from docker/compose.yml
DATABASE_URL=postgres://perfume:perfume@localhost:5432/perfume
# Integration tests: leave empty to use Testcontainers, or point to the compose test DB
TEST_DATABASE_URL=postgres://perfume:perfume@localhost:5432/perfume_test
# Better Auth: generate with `openssl rand -base64 32` (required in production)
BETTER_AUTH_SECRET=
# Google sign-in for customers (optional; both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HMAC key for worker -> web internal calls (required in production)
INTERNAL_API_SECRET=
# Worker -> web base URL (defaults to APP_URL; http://web:3000 in Docker)
INTERNAL_APP_URL=
# Mailpit from docker/compose.yml
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Perfume Store <no-reply@localhost>"
# Sentry (optional; leave empty to disable). Events are PII-scrubbed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
# Media storage: s3 (AWS / MinIO / S3-compatible) or local (dev only, served by /api/media).
# Defaults to s3 when S3_BUCKET is set, otherwise local outside production.
MEDIA_STORAGE=
MEDIA_LOCAL_DIR=.data/media
# MinIO from docker/compose.yml: S3_ENDPOINT=http://localhost:9000, S3_BUCKET=perfume-media,
# keys minioadmin/minioadmin, NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/perfume-media
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Public base URL for media (bucket website or CDN); defaults to /api/media in development
NEXT_PUBLIC_MEDIA_BASE_URL=
# Payments (ADR-0007: secrets only in env). Leave empty in development to use the sandbox
# simulator (no network; signed with public dev keys). Production requires real keys.
# VNPay: merchant code + HMAC-SHA512 hash secret (both or neither)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# payOS (VietQR): all three or none
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_URL=https://api-merchant.payos.vn
# true = force the simulator for every gateway (E2E); refused in production unless APP_URL is localhost
PAYMENT_SIMULATOR=
# --- M2 account & notifications ---
# Internal staff alerts (ADR-0019): email recipient and Telegram bot; each channel is skipped
# when unset. Telegram messages carry only order code, amount and province (no PII).
STAFF_ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- M3 hardening (ARCHITECTURE.md §12; docs/ops/runbook.md) ---
# The one header carrying the real client IP, overwritten by the reverse proxy
# (cf-connecting-ip behind Cloudflare, or the header Caddy sets from {client_ip}).
# Empty = no header trusted (dev). Required in production. Never x-forwarded-for unless your
# own proxy rewrites it (E2E uses x-forwarded-for against localhost only).
TRUSTED_IP_HEADER=
# Cloudflare Turnstile (sign-up, sign-in, forgot password, order lookup, place order).
# Both empty = off (dev, E2E). The site key is inlined at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# CSP: true = Content-Security-Policy-Report-Only (roll-out); reports go to CSP_REPORT_URI or,
# when empty, to Sentry's security endpoint derived from NEXT_PUBLIC_SENTRY_DSN.
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
# Payment webhook IP allowlists (comma-separated IPs / CIDRs from the gateways' docs).
# Empty = off; signatures are verified either way.
VNPAY_IPN_ALLOWED_IPS=
PAYOS_WEBHOOK_ALLOWED_IPS=
