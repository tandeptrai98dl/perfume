# Copy to .env.local for local development. Never commit real secrets (ADR-0007).
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Perfume Store"
# PostgreSQL 17 from docker/compose.yml
DATABASE_URL=postgres://perfume:perfume@localhost:5432/perfume
# Integration tests: leave empty to use Testcontainers, or point to the compose test DB
TEST_DATABASE_URL=postgres://perfume:perfume@localhost:5432/perfume_test
# Better Auth: generate with `openssl rand -base64 32` (required in production)
BETTER_AUTH_SECRET=
# Google sign-in for customers (optional; both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HMAC key for worker -> web internal calls (required in production)
INTERNAL_API_SECRET=
# Worker -> web base URL (defaults to APP_URL; http://web:3000 in Docker)
INTERNAL_APP_URL=
# Mailpit from docker/compose.yml
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Perfume Store <no-reply@localhost>"
# Sentry (optional; leave empty to disable). Events are PII-scrubbed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
