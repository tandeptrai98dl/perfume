# Caddy in front of the web container (docs/ops/runbook.md). Traffic arrives from Cloudflare
# (proxied DNS); the VM firewall only admits Cloudflare's ranges on 80/443.
{
	servers {
		# Cloudflare edge ranges (https://www.cloudflare.com/ips/, review quarterly). Only these
		# may set the client IP; {client_ip} is then CF-Connecting-IP, otherwise the TCP peer.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Static assets are content-hashed: cache for a year at Cloudflare and in browsers.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000 {
		# The one header the app trusts (TRUSTED_IP_HEADER=x-client-ip): always overwritten,
		# so a client-supplied value never reaches the app.
		header_up X-Client-IP {client_ip}
		health_uri /api/health/live
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}
